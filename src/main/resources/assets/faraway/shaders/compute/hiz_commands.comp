uniform int Count,Paint;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=uint(Count))return;uvec2 entry=Entries[i];bool hidden=entry.x!=0xffffffffu&&Visible[entry.x]==0u;if(hidden)Words[entry.y]=0u;else if(Paint!=0)PaintedWords[entry.y]=0u;}
