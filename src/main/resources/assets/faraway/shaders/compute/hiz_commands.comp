#extension GL_ARB_shader_storage_buffer_object : require
#extension GL_ARB_shader_image_load_store : require
#extension GL_ARB_shading_language_420pack : require
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer Visibility {uint Visible[];};
layout(std430,binding=1) buffer Arguments {uint Words[];};
layout(std430,binding=2) readonly buffer Metadata {uvec2 Entries[];};
