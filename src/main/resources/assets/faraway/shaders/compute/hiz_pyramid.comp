#version 330
#extension GL_ARB_compute_shader : require
#extension GL_ARB_shader_storage_buffer_object : require
#extension GL_ARB_shader_image_load_store : require
#extension GL_ARB_shading_language_420pack : require
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D SourceDepth;
layout(r32f,binding=0) readonly uniform image2D Previous;
layout(r32f,binding=1) writeonly uniform image2D Destination;
uniform int CopyDepth;
uniform ivec2 ViewSize,SourceSize,DestinationSize;
void main(){
 ivec2 p=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(p,DestinationSize)))return;
 float d=0.0;
 if(CopyDepth!=0){if(all(lessThan(p,ViewSize)))d=texelFetch(SourceDepth,p,0).r;}
 else {ivec2 q=p*2,limit=SourceSize-1;d=min(min(imageLoad(Previous,min(q,limit)).r,imageLoad(Previous,min(q+ivec2(1,0),limit)).r),min(imageLoad(Previous,min(q+ivec2(0,1),limit)).r,imageLoad(Previous,min(q+ivec2(1,1),limit)).r));}
 imageStore(Destination,p,vec4(d));
}
